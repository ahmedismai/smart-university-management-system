# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local credentials
/accounts.json

# local-only files (not part of the app)
/WhatsApp Image*
/pay_patch.py
/Finale finale.docx
/.agents
/skills-lock.json

# generated / private documents (not needed to run the app)
*.docx
*.pptx
*.pdf
/docs/meetings/
/docs/SUMS_Arabic_System_Documentation.html
/docs/diagrams/H.txt

# graduation book & documentation generators (local only)
/scripts/build_sums_book.js
/scripts/book_helpers.js
/scripts/content_*.js
/scripts/generate_arabic_documentation_pdf.py

# loose images / screenshots in the project root
/*.jpg
/*.jpeg
/*.png
__pycache__/
*.pyc
.claude/
.vscode/
Thumbs.db
