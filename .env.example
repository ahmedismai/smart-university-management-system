# Copy this file to .env.local and fill in your own values. Never commit real credentials.
# On Vercel add the same variables under Project Settings > Environment Variables.

# MongoDB connection string (required). Atlas: Network Access must allow 0.0.0.0/0 for Vercel.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sums_db?retryWrites=true&w=majority

# Chat / online-class socket server (run locally with: npm run chat).
# Vercel cannot host a WebSocket server: deploy socket-server.js on Render/Railway/Fly and put its public URL here.
# Locally it is optional (defaults to <current host>:3001).
# NEXT_PUBLIC_SOCKET_URL=https://your-socket-server.onrender.com

# Online classes: TURN server credentials (optional, needed only across different networks)
# Get them from https://www.metered.ca -> TURN Server -> Credentials
# NEXT_PUBLIC_TURN_URL=turn:<host>:443
# NEXT_PUBLIC_TURN_USERNAME=<username>
# NEXT_PUBLIC_TURN_CREDENTIAL=<credential>

# SUMS Assistant (chatbot). Without a key it still answers from built-in data.
# Preferred: Google Gemini (key from https://aistudio.google.com/apikey)
# GEMINI_API_KEY=<key>
# AI_MODEL_NAME=<gemini model name>
# Alternative: Claude (https://console.anthropic.com), used only if GEMINI_API_KEY is not set or fails
# ANTHROPIC_API_KEY=<key>
# Optional: model for the chatbot
# CHATBOT_MODEL=<model name>

# --- Socket server only (set these on the socket host, not on Vercel) ---
# PORT=3001
# MONGODB_URI=<same as above>
# ALLOWED_ORIGIN=https://your-project.vercel.app
